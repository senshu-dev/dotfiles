// fastfetch default config: grouped boxes + kitty-icat logo.
// Boxed sections via box-drawing custom modules (fastfetch examples/12.jsonc).
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty-icat",
        "source": "~/.local/share/rice-assets/frieren-fastfetch-logo.jpg",
        "width": 24,
        "preserveAspectRatio": true,
        "padding": {
            "top": 0
        }
    },
    "display": {
        "constants": [
            "────────────────"
        ],
        "key": {
            "type": "both"
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "┌{$1} System {$1}┐"
        },
        { "key": " OS", "type": "os" },
        { "key": " Host", "type": "host" },
        { "key": " Uptime", "type": "uptime" },
        { "key": " Packages", "type": "packages", "format": "{pacman}" },
        { "key": " Shell", "type": "shell" },
        { "key": " Terminal", "type": "terminal" },
        { "key": " WM", "type": "wm", "format": "{pretty-name} {version}" },
        {
            "type": "custom",
            "format": "└{$1}────────{$1}┘"
        },
        "break",
        {
            "type": "custom",
            "format": "┌{$1} Hardware {$1}┐"
        },
        { "key": " CPU", "type": "cpu", "format": "{name} @ {freq-max}" },
        { "key": " GPU", "type": "gpu", "format": "{name}" },
        { "key": " Memory", "type": "memory", "format": "{used} / {total}" },
        { "key": " Disk", "type": "disk", "format": "{size-used} / {size-total} - {filesystem}" },
        {
            "type": "custom",
            "format": "└{$1}──────────{$1}┘"
        },
        "break",
        "break"
    ]
}
